[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

macos.debug = "res://addons/godot_grid/bin/libgodot_grid.dylib"
macos.release = "res://addons/godot_grid/bin/libgodot_grid.dylib"
linux.debug.x86_64 = "res://addons/godot_grid/bin/libgodot_grid.so"
linux.release.x86_64 = "res://addons/godot_grid/bin/libgodot_grid.so"
windows.debug.x86_64 = "res://addons/godot_grid/bin/godot_grid.dll"
windows.release.x86_64 = "res://addons/godot_grid/bin/godot_grid.dll"

