[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.3"
reloadable = true

[libraries]

macos.debug = "res://addons/godot_world_streaming/bin/libgodot_world_streaming.dylib"
macos.release = "res://addons/godot_world_streaming/bin/libgodot_world_streaming.dylib"
linux.debug.x86_64 = "res://addons/godot_world_streaming/bin/libgodot_world_streaming.so"
linux.release.x86_64 = "res://addons/godot_world_streaming/bin/libgodot_world_streaming.so"
windows.debug.x86_64 = "res://addons/godot_world_streaming/bin/godot_world_streaming.dll"
windows.release.x86_64 = "res://addons/godot_world_streaming/bin/godot_world_streaming.dll"

